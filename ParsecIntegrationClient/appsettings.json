{
  "Paths": {
    // Рабочий каталог службы: журнал, state.json, прежний файл настроек.
    "MainPath": "C:\\IntegrationClient"
  },

  "Log": {
    // Уровень журнала приложения (категории = имена классов):
    // Trace | Debug | Information | Warning | Error | Critical | None
    "Level": "Warning",
    // Уровень служебных категорий Microsoft.* и System.* (хост, DI, конфигурация).
    "FrameworkLevel": "Warning",
    // Пусто — писать в <MainPath>\log. Файл: Log_At_ГГГГ_М_Д.txt (прежний формат).
    "FolderPath": "",
    // Сколько файлов журнала хранить.
    "RetainedFileCount": 31
  },

  "Parsec": {
    // SOAP-сервис интеграции Парсека. Адрес применяется к WCF-клиенту при каждом
    // создании; значение адреса из WSDL (сгенерированный клиент) не используется.
    "Url": "http://127.0.0.1:10101/IntegrationService/IntegrationService.asmx",
    "Domain": "SYSTEM",
    "User": "parsec",
    "Password": "parsec",
    // Таймаут одного SOAP-запроса, секунды (Open/Send/Receive/Close в WCF).
    "TimeoutSeconds": 100,
    // Продление сессии Парсека, секунды (раньше ContinueSessionJob — 4 минуты).
    "SessionContinueSeconds": 240,
    // Пауза между попытками авторизации, если Парсек недоступен, секунды.
    "SessionRetrySeconds": 60
  },

  "Service": {
    // Строка подключения к БД Артонит (Firebird/ShieldPro). Обязательна.
    // Пример:
    // "User=SYSDBA;Password=masterkey;Database=C:\\Program Files (x86)\\Cardsoft\\DuoSE\\Access\\ShieldPro_rest.gdb;
    //  DataSource=127.0.0.1;Port=3050;Dialect=3;Charset=win1251;ServerType=0;"
    // Если не задана здесь, берётся из прежнего C:\IntegrationClient\appsettings.json
    // (_databaseConnectionString). Если нет нигде — служба пишет в журнал Critical
    // "Нет подключения к базе данных Артонит: строка подключения не задана" и очередь не обрабатывает.
    "DatabaseConnectionString": "",
    // Запрос очереди заданий. Пусто — значение по умолчанию из кода.
    "QuerySelectIdDevCardString": "",
    // Интервал обработки очереди, секунды (раньше триггер Quartz на 600 с).
    "JobIntervalSeconds": 600,
    // Пауза после ошибки, минуты (раньше _errorTimeoutMinutes).
    "ErrorTimeoutMinutes": 1,
    // Коды ошибок, при которых задание удаляется из очереди (раньше _skipErrCode).
    "SkipErrCode": [],
    // Пауза между повторными проверками подключения к БД, секунды.
    "DatabaseRetrySeconds": 60
  }
}
