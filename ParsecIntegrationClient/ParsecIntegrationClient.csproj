<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    Схема как в basip_exe: Microsoft.NET.Sdk.Worker + Microsoft.Extensions.Hosting.
    Один и тот же exe запускается и в консоли, и как служба Windows (UseWindowsService).

    Целевая платформа — .NET 8 (net8.0-windows). SOAP-клиент Парсека перегенерирован
    из WSDL в IntegrationWebService\IntegrationService.cs средствами dotnet-svcutil
    (System.ServiceModel / BasicHttpBinding) — System.Web.Services, на котором был
    прежний Web Reference, в .NET 8 отсутствует.

    Поставка — штатный single-file publish .NET 8 (PublishSingleFile), без Costura/Fody
    и без самодельного встраивания DLL в ресурсы exe (EmbeddedAssemblies.cs удалён):
    приложение self-contained, поэтому на стенде не нужно отдельно ставить .NET 8.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ParsecIntegrationClient</RootNamespace>
    <AssemblyName>ParsecIntegrationClient</AssemblyName>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Явно: проект публикуется в папку (dotnet publish). -->
    <IsPublishable>true</IsPublishable>

    <!--
      Один exe без установленного .NET 8 на стенде. Если на целевых машинах
      .NET 8 уже развёрнут, можно собрать компактную framework-dependent поставку:
      dotnet publish -p:SelfContained=false -r win-x64 (потребуется runtime 8.0.x).
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Trimming не включаем: XmlSerializer (SOAP), Firebird и конфигурация используют
         рефлексию, IL-обрезка для них небезопасна. -->

    <Version>4.0.0</Version>
    <AssemblyVersion>4.0.0</AssemblyVersion>
    <FileVersion>4.0.0</FileVersion>

    <Product>ParsecIntegrationClient</Product>
    <AssemblyTitle>ParsecIntegrationClient</AssemblyTitle>
    <Description>Модуль интеграции СКУД Артонит и СКУД Парсек. Данные из Артонит передаются в Парсек.</Description>
    <Copyright>Copyright © 2023</Copyright>
    <Trademark>Артонит</Trademark>
  </PropertyGroup>

  <ItemGroup>
    <!-- Firebird: БД Артонит (ShieldPro). -->
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="9.1.1" />

    <!-- Хостинг: консоль + служба Windows, DI, конфигурация, журналирование. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.2" />

    <!-- SOAP-клиент Парсека: WCF-клиент для .NET 8 (прежний прокси был на System.Web.Services). -->
    <PackageReference Include="System.ServiceModel.Http" Version="8.0.0" />

    <!-- Json.NET остаётся: на нём построены Models\State.cs и разбор прежнего appsettings.json. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Единственный файл настроек, кладётся рядом с exe. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Скрипты установки и README нужны в папке поставки, но не в промежуточном bin. -->
    <None Update="install-service.ps1" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    <None Update="uninstall-service.ps1" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    <None Update="README.md" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
