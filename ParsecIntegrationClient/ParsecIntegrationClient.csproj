<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    Схема как в basip_exe: Microsoft.NET.Sdk.Worker + Microsoft.Extensions.Hosting.
    Один и тот же exe запускается и в консоли, и как служба Windows (UseWindowsService).
    Quartz, Fody/Costura, Service1 и ProjectInstaller не используются.

    Target framework — .NET Framework 4.7.2, потому что SOAP-прокси Парсека
    (Web References\IntegrationWebService\Reference.cs) сгенерирован под System.Web.Services,
    которого в .NET 8 нет. Переход на net8.0-windows — отдельная задача с перегенерацией прокси.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ParsecIntegrationClient</RootNamespace>
    <AssemblyName>ParsecIntegrationClient</AssemblyName>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Явно: проект публикуется в папку (dotnet publish). ClickOnce в SDK-проектах не поддерживается,
         поэтому в меню Visual Studio пункта "Публиковать..." для net472 нет - публикация идёт
         через build.cmd или install-service.ps1. -->
    <IsPublishable>true</IsPublishable>

    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>

    <Version>2.0.1</Version>
    <AssemblyVersion>2.0.1</AssemblyVersion>
    <FileVersion>2.0.1</FileVersion>

    <Product>ParsecIntegrationClient</Product>
    <AssemblyTitle>ParsecIntegrationClient</AssemblyTitle>
    <Description>Модуль интеграции СКУД Артонит и СКУД Парсек. Данные из Артонит передаются в Парсек.</Description>
    <Copyright>Copyright © 2023</Copyright>
    <Trademark>Артонит</Trademark>
  </PropertyGroup>

  <ItemGroup>
    <!-- Firebird: БД Артонит (ShieldPro). -->
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="9.1.1" />

    <!-- Хостинг: консоль + служба Windows, DI, конфигурация, журналирование. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.2" />

    <!-- Json.NET остаётся: на нём построены Models\State.cs и разбор прежнего appsettings.json. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ссылки .NET Framework, нужные сгенерированному SOAP-прокси Парсека
         (ApplicationSettingsBase — System.Configuration, SoapHttpClientProtocol — System.Web.Services). -->
    <Reference Include="System.Configuration" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Services" />
  </ItemGroup>

  <!--
    Поставка из одного файла. На .NET Framework нет PublishSingleFile, поэтому зависимости
    (Microsoft.Extensions.*, FirebirdSql, Newtonsoft и т.д.) встраиваются в exe ресурсами,
    а EmbeddedAssemblies.cs отдаёт их среде по требованию.
  -->
  <PropertyGroup>
    <EmbedAssembliesIntoExe>true</EmbedAssembliesIntoExe>
  </PropertyGroup>

  <Target Name="EmbedReferencedAssemblies" AfterTargets="ResolveReferences" Condition="'$(EmbedAssembliesIntoExe)' == 'true'">
    <ItemGroup>
      <_AssemblyToEmbed Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll'" />
      <!-- Сателлиты локализации встраивать нельзя: у них своя культура и имя ресурса. -->
      <_AssemblyToEmbed Remove="@(_AssemblyToEmbed)" Condition="$([System.String]::Copy('%(Filename)').EndsWith('.resources'))" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="@(_AssemblyToEmbed)">
        <LogicalName>%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>

    <Message Importance="high" Text="Встроено в exe сборок: @(_AssemblyToEmbed-&gt;Count())" />
  </Target>

  <!-- После публикации DLL не нужны: они уже внутри exe. Остаются exe, конфигурация и скрипты. -->
  <Target Name="TrimPublishToSingleExe" AfterTargets="Publish" Condition="'$(EmbedAssembliesIntoExe)' == 'true'">
    <ItemGroup>
      <_PublishRedundantDll Include="$([MSBuild]::EnsureTrailingSlash($(PublishDir)))**\*.dll" />
      <_PublishRedundantDll Include="$([MSBuild]::EnsureTrailingSlash($(PublishDir)))**\*.deps.json" />
    </ItemGroup>

    <Delete Files="@(_PublishRedundantDll)" />
  </Target>

  <ItemGroup>
    <!-- Единственный файл настроек, кладётся рядом с exe. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Скрипты установки и README нужны в папке поставки, но не в промежуточном bin. -->
    <None Update="install-service.ps1" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    <None Update="uninstall-service.ps1" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    <None Update="README.md" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>



