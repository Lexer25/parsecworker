<?xml version="1.0" encoding="utf-8"?>
<!--
  Профиль публикации в папку (net8.0-windows, self-contained single-file).
  Используется так:
      dotnet publish .\ParsecIntegrationClient\ParsecIntegrationClient.csproj -p:PublishProfile=FolderProfile
  Результат кладётся в C:\ParsecIntegrationClinet_worker\publish.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>..\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
