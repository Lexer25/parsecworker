<Window x:Class="ParsecQueueViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Очередь интегратора — PARSEC"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Language="ru-RU"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="SummaryNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>

        <Style x:Key="GridValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="GridMutedValue" TargetType="TextBlock" BasedOn="{StaticResource GridValue}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#5D6B7E" />
        </Style>

        <Style x:Key="CompactHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderStyle}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="7,5" />
        </Style>

        <Style x:Key="CompactRow" TargetType="DataGridRow" BasedOn="{StaticResource GridRowStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Height" Value="30" />
        </Style>

        <Style x:Key="CompactCell" TargetType="DataGridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="Padding" Value="7,0" />
        </Style>

        <Style x:Key="FieldBlock" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,16,8" />
        </Style>

        <Style x:Key="FilterItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="{Binding Description}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="99"
                                Padding="11,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Label"
                                           Text="{Binding DisplayName}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#314052"
                                           VerticalAlignment="Center" />
                                <Border x:Name="CountBadge"
                                        Background="#F1F5F9"
                                        CornerRadius="99"
                                        Padding="6,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="CountText"
                                               Text="{Binding CountDisplay}"
                                               FontSize="10.5"
                                               Foreground="#65748A" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#B9CCED" />
                                <Setter TargetName="Chip" Property="Background" Value="#F8FAFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Label" Property="Foreground" Value="White" />
                                <Setter TargetName="CountBadge" Property="Background" Value="#4C83F3" />
                                <Setter TargetName="CountText" Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="210" />
            <RowDefinition Height="6" />
            <RowDefinition Height="280" MinHeight="180" MaxHeight="420" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid Margin="22,13,22,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="42" Height="42" CornerRadius="11"
                            Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="3" Canvas.Top="5" Width="18" Height="3.4"
                                           RadiusX="1.7" RadiusY="1.7" Fill="White" />
                                <Rectangle Canvas.Left="3" Canvas.Top="11" Width="14" Height="3.4"
                                           RadiusX="1.7" RadiusY="1.7" Fill="White" />
                                <Rectangle Canvas.Left="3" Canvas.Top="17" Width="10" Height="3.4"
                                           RadiusX="1.7" RadiusY="1.7" Fill="#BFDBFE" />
                                <Ellipse Canvas.Left="16.5" Canvas.Top="10.5" Width="4.5" Height="4.5"
                                         Fill="#93C5FD" />
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="13,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Очередь интегратора"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#172234" />
                        <TextBlock Text="{Binding HeaderSubtitle}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ConnectionTooltip}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border CornerRadius="99"
                                Padding="10,6"
                                Margin="0,0,10,0"
                                ToolTip="{Binding EventsModeTooltip}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F1F5F9" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Background" Value="#FEF3C7" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEventsOnline}" Value="True">
                                            <Setter Property="Background" Value="#DCFCE7" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasConnectionError}" Value="True">
                                            <Setter Property="Background" Value="#FEF3C7" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasConfigurationError}" Value="True">
                                            <Setter Property="Background" Value="#FEE2E2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#94A3B8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="#D97706" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsEventsOnline}" Value="True">
                                                    <Setter Property="Fill" Value="#16A34A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasConnectionError}" Value="True">
                                                    <Setter Property="Fill" Value="#D97706" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasConfigurationError}" Value="True">
                                                    <Setter Property="Fill" Value="#DC2626" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ConnectionStatusText}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#475569" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Foreground" Value="#B45309" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsEventsOnline}" Value="True">
                                                    <Setter Property="Foreground" Value="#15803D" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasConnectionError}" Value="True">
                                                    <Setter Property="Foreground" Value="#B45309" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasConfigurationError}" Value="True">
                                                    <Setter Property="Foreground" Value="#B91C1C" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button Content="Выбрать appsettings.json"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                Click="ChooseConfig_Click"
                                ToolTip="Указать файл настроек службы интегратора" />
                        <Button Content="Обновить"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding RefreshCommand}"
                                ToolTip="Обновить очередь (F5)" />
                    </StackPanel>
                </Grid>

                <ProgressBar Height="3"
                             VerticalAlignment="Bottom"
                             IsIndeterminate="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource AccentBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- Нет appsettings.json -->
        <Border Grid.Row="1"
                Margin="22,12,22,0"
                Background="#FFF7ED"
                BorderBrush="#FED7AA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Visibility="{Binding HasConfigurationError, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="24" CornerRadius="12" Background="#FDBA74" Margin="0,0,10,0">
                    <TextBlock Text="!"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#7C2D12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Не загружены параметры подключения"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               Foreground="#7C2D12" />
                    <TextBlock Text="{Binding ConfigurationErrorText}"
                               FontSize="11.5"
                               Foreground="#9A3412"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2"
                        Content="Выбрать файл"
                        Style="{StaticResource SecondaryButton}"
                        Margin="14,0,0,0"
                        Click="ChooseConfig_Click"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Ошибка подключения -->
        <Border Grid.Row="2"
                Margin="22,10,22,0"
                Background="#FEF2F2"
                BorderBrush="#FECACA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,9"
                Visibility="{Binding HasConnectionError, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="24" CornerRadius="12" Background="#FCA5A5" Margin="0,0,10,0">
                    <TextBlock Text="×"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#7F1D1D"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Не удалось прочитать очередь"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               Foreground="#991B1B" />
                    <TextBlock Text="{Binding ConnectionErrorText}"
                               FontSize="11.5"
                               Foreground="#B91C1C"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2"
                        Content="Повторить"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center" />
                <Button Grid.Column="3"
                        Content="Сменить настройки"
                        Style="{StaticResource FlatButton}"
                        Margin="4,0,0,0"
                        Click="ChooseConfig_Click"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Событие Firebird недоступно: нет триггера, нет связи или нет прав -->
        <Border Grid.Row="3"
                Margin="22,10,22,0"
                Background="#FFFBEB"
                BorderBrush="#FDE68A"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,9"
                Visibility="{Binding HasEventsWarning, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="24" CornerRadius="12" Background="#FCD34D" Margin="0,0,10,0">
                    <TextBlock Text="!"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#78350F"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Обновление по событию Firebird не работает"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               Foreground="#78350F" />
                    <TextBlock Text="{Binding EventsWarningText}"
                               FontSize="11.5"
                               Foreground="#92400E"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2"
                        Content="Обновить"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Сводка -->
        <UniformGrid Grid.Row="4" Columns="5" Margin="22,16,22,0">
            <Border Style="{StaticResource CardStyle}" Padding="15,12" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#2563EB" CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Ожидают" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding PendingCount, StringFormat={}{0:N0}}"
                                   Style="{StaticResource SummaryNumber}" />
                        <TextBlock Text="новые события" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="15,12" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#D97706" CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="В работе" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding InWorkCount, StringFormat={}{0:N0}}"
                                   Style="{StaticResource SummaryNumber}" />
                        <TextBlock Text="забрано интегратором" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="15,12" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#DC2626" CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Требуют внимания" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding ProblemsCount, StringFormat={}{0:N0}}"
                                   Style="{StaticResource SummaryNumber}" />
                        <TextBlock Text="{Binding ProblemsDetail}"
                                   Style="{StaticResource CaptionText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ProblemsDetail}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="15,12" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#16A34A" CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Успешно" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding SuccessCount, StringFormat={}{0:N0}}"
                                   Style="{StaticResource SummaryNumber}" />
                        <TextBlock Text="статус 2" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="15,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#64748B" CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Всего в очереди" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding TotalCount, StringFormat={}{0:N0}}"
                                   Style="{StaticResource SummaryNumber}" />
                        <TextBlock Text="PARSEC_QUEUE" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Фильтры и поиск -->
        <Grid Grid.Row="5" Margin="22,16,22,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListBox ItemsSource="{Binding Filters}"
                     SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource FilterItem}"
                     VerticalAlignment="Center"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <Grid Grid.Column="1" Width="340" Height="35">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource SearchTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Поиск по ID, статусу, операции, сотруднику, карте, ошибке, dedup-ключу и worker" />
                <TextBlock Text="Поиск по ID, сотруднику, карте, ошибке…"
                           Margin="11,0,30,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#9AA5B5"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="×"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,2,0"
                        Padding="7,3"
                        FontSize="15"
                        Click="ClearSearch_Click"
                        ToolTip="Очистить поиск">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>

        <!-- Таблица очереди -->
        <Border Grid.Row="6"
                Margin="22,0,22,0"
                Style="{StaticResource CardStyle}"
                ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="QueueGrid"
                          ItemsSource="{Binding RowsView}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserReorderColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeaderWidth="0"
                          Background="White"
                          BorderThickness="0"
                          ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                          CellStyle="{StaticResource GridCellStyle}"
                          RowStyle="{StaticResource GridRowStyle}"
                          AlternatingRowBackground="#FBFCFE"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="64"
                                            SortMemberPath="Id"
                                            ElementStyle="{StaticResource GridMutedValue}" />

                        <DataGridTemplateColumn Header="Статус" Width="108" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Background}"
                                            CornerRadius="99"
                                            Padding="8,3"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusName}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Foreground}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Команда" Width="210" SortMemberPath="Operation">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="0,4,0,4">
                                        <TextBlock Text="{Binding OperationName}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding OperationCodeDisplay}"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Объект" Width="235" SortMemberPath="ObjectTitle">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="0,4,0,4">
                                        <TextBlock Text="{Binding ObjectTitle}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ObjectSubtitle}"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ObjectSubtitle}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Попытки"
                                            Binding="{Binding AttemptsDisplay}"
                                            Width="76"
                                            SortMemberPath="Attempts"
                                            ElementStyle="{StaticResource GridMutedValue}" />

                        <DataGridTextColumn Header="Создано"
                                            Binding="{Binding CreatedDisplay}"
                                            Width="132"
                                            ElementStyle="{StaticResource GridMutedValue}" />

                        <DataGridTextColumn Header="Завершено"
                                            Binding="{Binding FinishedDisplay}"
                                            Width="132"
                                            ElementStyle="{StaticResource GridMutedValue}" />

                        <DataGridTextColumn Header="Длит."
                                            Binding="{Binding DurationDisplay}"
                                            Width="82"
                                            ElementStyle="{StaticResource GridMutedValue}" />

                        <DataGridTemplateColumn Header="Ошибка" Width="*" MinWidth="170" SortMemberPath="ErrorText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ErrorDisplay}"
                                               FontSize="11.5"
                                               Foreground="#A33A2B"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding ErrorText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="#FAFCFF"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                        IsHitTestVisible="False">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="26" Background="#EEF3FA" Margin="0,0,0,12">
                            <TextBlock Text="≡"
                                       FontSize="26"
                                       Foreground="#90A1B8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding EmptyMessage}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#536174"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Данные обновляются по событию Firebird; F5 — обновить сейчас"
                                   FontSize="11.5"
                                   Foreground="#8A96A8"
                                   Margin="0,5,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="7"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows"
                      ShowsPreview="True" />

        <!-- Детали выбранного события -->
        <Border Grid.Row="8"
                Margin="22,0,22,0"
                Style="{StaticResource CardStyle}"
                ClipToBounds="True">
            <Grid Margin="16,11">
                <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedRow.DetailsTitle}"
                                       FontSize="14.5"
                                       FontWeight="SemiBold" />
                            <Border Background="{Binding SelectedRow.Status, Converter={StaticResource StatusBrush}, ConverterParameter=Background}"
                                    CornerRadius="99"
                                    Padding="7,2"
                                    Margin="9,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedRow.StatusName}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding SelectedRow.Status, Converter={StaticResource StatusBrush}, ConverterParameter=Foreground}" />
                            </Border>
                            <TextBlock Text="{Binding SelectedRow.StatusDescription}"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="9,0,0,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,9,0,0">
                            <StackPanel Style="{StaticResource FieldBlock}">
                                <TextBlock Text="Операция" Style="{StaticResource DetailLabel}" />
                                <TextBlock Text="{Binding SelectedRow.OperationName}"
                                           Style="{StaticResource DetailValue}"
                                           ToolTip="{Binding SelectedRow.OperationCodeDisplay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldBlock}">
                                <TextBlock Text="Объект" Style="{StaticResource DetailLabel}" />
                                <TextBlock Text="{Binding SelectedRow.ObjectTitle}"
                                           Style="{StaticResource DetailValue}"
                                           ToolTip="{Binding SelectedRow.ObjectSubtitle}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldBlock}">
                                <TextBlock Text="ID_PEP" Style="{StaticResource DetailLabel}" />
                                <TextBlock Text="{Binding SelectedRow.IdPepDisplay}" Style="{StaticResource DetailValue}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldBlock}">
                                <TextBlock Text="ID_CARD" Style="{StaticResource DetailLabel}" />
                                <TextBlock Text="{Binding SelectedRow.IdCardDisplay}"
                                           Style="{StaticResource DetailValue}"
                                           ToolTip="{Binding SelectedRow.IdCardDisplay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldBlock}">
                                <TextBlock Text="Создано" Style="{StaticResource DetailLabel}" />
                                <TextBlock Text="{Binding SelectedRow.CreatedDisplay}" Style="{StaticResource DetailValue}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldBlock}">
                                <TextBlock Text="Запущено" Style="{StaticResource DetailLabel}" />
                                <TextBlock Text="{Binding SelectedRow.StartedDisplay}" Style="{StaticResource DetailValue}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldBlock}">
                                <TextBlock Text="Завершено" Style="{StaticResource DetailLabel}" />
                                <TextBlock Text="{Binding SelectedRow.FinishedDisplay}" Style="{StaticResource DetailValue}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldBlock}">
                                <TextBlock Text="Длительность" Style="{StaticResource DetailLabel}" />
                                <TextBlock Text="{Binding SelectedRow.DurationDisplay}" Style="{StaticResource DetailValue}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldBlock}">
                                <TextBlock Text="Попытки" Style="{StaticResource DetailLabel}" />
                                <TextBlock Text="{Binding SelectedRow.AttemptsDisplay}" Style="{StaticResource DetailValue}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldBlock}">
                                <TextBlock Text="Worker" Style="{StaticResource DetailLabel}" />
                                <TextBlock Text="{Binding SelectedRow.WorkerDisplay}"
                                           Style="{StaticResource DetailValue}"
                                           ToolTip="{Binding SelectedRow.WorkerDisplay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldBlock}">
                                <TextBlock Text="Dedup-ключ" Style="{StaticResource DetailLabel}" />
                                <TextBlock Text="{Binding SelectedRow.DedupDisplay}"
                                           Style="{StaticResource DetailValue}"
                                           ToolTip="{Binding SelectedRow.DedupDisplay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldBlock}">
                                <TextBlock Text="Источник" Style="{StaticResource DetailLabel}" />
                                <TextBlock Text="{Binding SelectedRow.SourceDisplay}" Style="{StaticResource DetailValue}" />
                            </StackPanel>
                        </UniformGrid>

                        <Grid Grid.Row="2" Margin="0,2,14,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource DetailLabel}" Margin="0,0,0,4">
                                <Run Text="Текст ошибки" />
                                <Run Text="{Binding SelectedRow.ErrorCodeDisplay, Mode=OneWay, StringFormat=' · код {0}'}" />
                                <Run Text=" (можно выделить и скопировать)" />
                            </TextBlock>
                            <TextBox Grid.Row="1"
                                     Text="{Binding SelectedRow.ErrorText, Mode=OneWay, TargetNullValue='Ошибка не указана'}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="#FFFAFA"
                                     BorderBrush="#F0D9D6"
                                     BorderThickness="1"
                                     Padding="8,6"
                                     FontSize="11.5"
                                     Foreground="#8B2F25"
                                     MaxHeight="64" />
                        </Grid>
                    </Grid>

                    <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" Margin="12,0" />

                    <Grid Grid.Column="2" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="История попыток"
                                       FontSize="14.5"
                                       FontWeight="SemiBold" />
                            <Border Background="#EEF2F7"
                                    CornerRadius="99"
                                    Padding="7,1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding HistoryCount}"
                                           FontSize="10.5"
                                           Foreground="#536174" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding HistoryStatusText}"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,3,0,6"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding HistoryStatusText}" />

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding History}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  RowHeaderWidth="0"
                                  Background="White"
                                  BorderThickness="0"
                                  RowHeight="30"
                                  ColumnHeaderStyle="{StaticResource CompactHeader}"
                                  CellStyle="{StaticResource CompactCell}"
                                  RowStyle="{StaticResource CompactRow}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№"
                                                    Binding="{Binding AttemptNo}"
                                                    Width="42"
                                                    ElementStyle="{StaticResource GridMutedValue}" />
                                <DataGridTextColumn Header="Статус"
                                                    Binding="{Binding StatusName}"
                                                    Width="94"
                                                    ElementStyle="{StaticResource GridValue}" />
                                <DataGridTextColumn Header="Начата"
                                                    Binding="{Binding StartedDisplay}"
                                                    Width="122"
                                                    ElementStyle="{StaticResource GridMutedValue}" />
                                <DataGridTextColumn Header="Длит."
                                                    Binding="{Binding DurationDisplay}"
                                                    Width="64"
                                                    ElementStyle="{StaticResource GridMutedValue}" />
                                <DataGridTextColumn Header="Worker"
                                                    Binding="{Binding WorkerDisplay}"
                                                    Width="86"
                                                    ElementStyle="{StaticResource GridMutedValue}" />
                                <DataGridTemplateColumn Header="Ошибка" Width="*" MinWidth="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ErrorDisplay}"
                                                       FontSize="10.5"
                                                       Foreground="#A33A2B"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding ErrorText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Детали" Width="58">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DetailsDisplay}"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Details}"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="Выберите событие в очереди"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="#697789"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Здесь появятся параметры команды, текст ошибки и история попыток"
                               FontSize="11.5"
                               Foreground="#93A0B1"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Нижняя строка -->
        <Border Grid.Row="9"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="22,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E7F6EC" CornerRadius="99" Padding="7,2">
                        <TextBlock Text="Только чтение"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="#15803D" />
                    </Border>
                    <TextBlock Text="{Binding ConfigFileDisplay}"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ConfigTooltip}" />
                    <TextBlock Text="{Binding ConnectionDisplay}"
                               FontSize="11"
                               Foreground="#8793A6"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ConnectionTooltip}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,18,0">
                    <TextBlock Text="{Binding VisibleCountText}"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               ToolTip="Сколько строк видно после фильтра и поиска" />
                    <TextBlock Text=" · " FontSize="11" Foreground="#C0C8D4" />
                    <TextBlock Text="{Binding LoadedCountText}"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text=" · " FontSize="11" Foreground="#C0C8D4" />
                    <TextBlock Text="{Binding LastUpdatedText}"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text=" ⚠"
                               FontSize="11"
                               Foreground="#B45309"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasLimitNote, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="{Binding LoadLimitText}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Резервный опрос"
                              IsChecked="{Binding AutoRefresh}"
                              Style="{StaticResource CheckBoxStyle}"
                              ToolTip="Обновлять очередь по таймеру, если событие Firebird недоступно"
                              VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding RefreshIntervals}"
                              SelectedItem="{Binding RefreshSeconds}"
                              Style="{StaticResource ComboStyle}"
                              Width="60"
                              Margin="8,0,4,0"
                              ToolTip="Интервал резервного опроса"
                              VerticalAlignment="Center" />
                    <TextBlock Text="с"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AppVersion, StringFormat='· v{0}'}"
                               FontSize="10.5"
                               Foreground="#A6B0BE"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
