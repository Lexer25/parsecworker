<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Desktop-монитор очереди PARSEC_QUEUE. Только чтение: приложение не меняет
    ни очередь, ни базу Артонит и не конкурирует со службой интегратора.
    Параметры подключения берутся из appsettings.json службы, а не из этого файла.
  -->
  <PropertyGroup>
    <!--
      Exe, а не WinExe: self-contained WPF-приложение с Windows-subsystem apphost
      на текущем стенде завершается до входа в managed Main. Консольное окно,
      которое создаёт Exe, сразу прячется в ConsoleWindowHider (module initializer).
      Из проводника пользователь видит только обычное окно WPF.
    -->
    <OutputType>Exe</OutputType>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ParsecQueueViewer</RootNamespace>
    <!--
      Wpf в имени exe отличает WPF-монитор от Win32-варианта
      (ParsecQueueViewerWin32.exe): они могут лежать рядом в одной поставке.
    -->
    <AssemblyName>ParsecQueueViewerWpf</AssemblyName>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!--
      Один автономный exe: .NET 8, WPF и провайдер Firebird упакованы внутрь,
      .NET на машине пользователя не нужен. Приложение можно переносить на другой
      компьютер копированием одного файла.
      Native-части WPF хост распаковывает при старте в %TEMP%\.net (или в каталог
      из DOTNET_BUNDLE_EXTRACT_BASE_DIR) — без этого single-file WPF не запускается.
      Провайдер Firebird 9.1.1 работает по управляемому протоколу, поэтому
      fbclient.dll рядом с exe не нужен.
    -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Символы внутри exe: в поставке не остаётся отдельного .pdb. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>

    <Version>1.1.2</Version>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
    <Product>Parsec Queue Viewer WPF</Product>
    <AssemblyTitle>Очередь интегратора PARSEC (WPF)</AssemblyTitle>
    <Description>Мониторинг PARSEC_QUEUE по событию Firebird PARSEC_QUEUE_CHANGED и резервному опросу.</Description>
    <Copyright>Copyright © 2026</Copyright>
    <Company>Артонит</Company>

    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="9.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\app.ico" />
    <Resource Include="Assets\app.ico" />
    <None Update="README.md" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
